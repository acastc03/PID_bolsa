{
  "name": "🌅 Data Ingestion - Sequential",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 23 * * 1-5"
            }
          ]
        }
      },
      "name": "Schedule 23:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [250, 300],
      "typeVersion": 1,
      "id": "schedule-trigger"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://mcp_finance:8000/health"
      },
      "name": "Check API Health",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 300],
      "typeVersion": 3,
      "id": "health-check"
    },
    {
      "parameters": {
        "jsCode": "return [{\"json\": {\"market\": \"IBEX35\"}}, {\"json\": {\"market\": \"SP500\"}}, {\"json\": {\"market\": \"NIKKEI\"}}];"
      },
      "name": "Markets List",
      "type": "n8n-nodes-base.code",
      "position": [650, 300],
      "typeVersion": 2,
      "id": "markets-list"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "name": "Process One By One",
      "type": "n8n-nodes-base.splitInBatches",
      "position": [850, 300],
      "typeVersion": 3,
      "id": "split-batches"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://mcp_finance:8000/update_prices?market=' + $json.market + '&period=5d' }}"
      },
      "name": "Update Prices",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1050, 300],
      "typeVersion": 3,
      "id": "update-prices"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://mcp_finance:8000/compute_indicators?market=' + $('Process One By One').item.json.market }}"
      },
      "name": "Compute Indicators",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1250, 300],
      "typeVersion": 3,
      "id": "compute-indicators"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://mcp_finance:8000/predecir_ensemble?market=' + $('Process One By One').item.json.market }}"
      },
      "name": "Generate Prediction",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1450, 300],
      "typeVersion": 3,
      "id": "generate-prediction"
    }
  ],
  "connections": {
    "Schedule 23:30": {
      "main": [
        [
          {
            "node": "Check API Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check API Health": {
      "main": [
        [
          {
            "node": "Markets List",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Markets List": {
      "main": [
        [
          {
            "node": "Process One By One",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process One By One": {
      "main": [
        [
          {
            "node": "Update Prices",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Update Prices": {
      "main": [
        [
          {
            "node": "Compute Indicators",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compute Indicators": {
      "main": [
        [
          {
            "node": "Generate Prediction",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Prediction": {
      "main": [
        [
          {
            "node": "Process One By One",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
